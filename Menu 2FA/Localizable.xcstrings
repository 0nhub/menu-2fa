    "The item is no longer available. Remove it and add it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد العنصر متاحًا. أزِله ثم أضِفه مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Element ist nicht mehr verfügbar. Entferne es und füge es erneut hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το στοιχείο δεν είναι πλέον διαθέσιμο. Καταργήστε το και προσθέστε το ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The item is no longer available. Remove it and add it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento ya no está disponible. Elimínalo y añádelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’élément n’est plus disponible. Supprimez-le, puis ajoutez-le de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפריט אינו זמין עוד. הסר אותו והוסף אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आइटम अब उपलब्ध नहीं है। इसे हटाकर फिर से जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item tidak lagi tersedia. Hapus lalu tambahkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elemento non è più disponibile. Rimuovilo e aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この項目は利用できなくなりました。削除して追加し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 더 이상 사용할 수 없습니다. 삭제한 후 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het item is niet meer beschikbaar. Verwijder het en voeg het opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Element jest już niedostępny. Usuń go i dodaj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O item já não está disponível. Remova-o e adicione-o novamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
